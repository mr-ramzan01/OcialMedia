# ---- Server ----
PORT=8080
# Comma separated list of origins allowed to call the API (first one is used for OAuth redirects)
CLIENT_URL=http://localhost:3000

# ---- Database ----
# Local MongoDB (default for development)
MONGO_URI=mongodb://127.0.0.1:27017/ocial_media_data
# Or MongoDB Atlas (legacy variables, used only when MONGO_URI is not set)
# DB_USERNAME=
# DB_PASSWORD=
# DB_URL=cluster0.xxxxx.mongodb.net

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud console
GOOGLE_REDIRECT_URI=http://localhost:3000/google_Oauth

# ---- Cloudinary (required for image uploads) ----
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
